---
interface Props { label: string; ratio?: string }
const { label, ratio = '4 / 3' } = Astro.props;
---
<figure class="photo-tbd" style={`aspect-ratio:${ratio}`} aria-label={`Photo placeholder: ${label}`}>
  <svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true"><rect x="4" y="10" width="40" height="30" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="25" r="8" fill="none" stroke="currentColor" stroke-width="2"/><rect x="16" y="6" width="16" height="6" rx="2" fill="currentColor"/></svg>
  <figcaption>[TBD: {label}]</figcaption>
</figure>
